# Copy to server/.env for local development. Never commit the real .env.
NODE_ENV=development
PORT=4000

# "mongo" (default) or "memory" (throwaway in-process store for demos)
DATA_STORE=mongo
MONGODB_URI=mongodb://127.0.0.1:27017/fitcoach

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=7d

# Allowed browser origins for CORS (the Vite dev server in development)
CLIENT_ORIGIN=http://localhost:5173
# How many proxies sit in front of the API: 1 = Render only, 2 = Vercel forwarding to Render
TRUST_PROXY=1

# USDA FoodData Central: free key from https://fdc.nal.usda.gov/api-key-signup
# DEMO_KEY works but is heavily rate-limited.
USDA_API_KEY=DEMO_KEY

# Optional: enables the AI coach (falls back to the rule-based coach if unset or failing)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Emails that receive the admin role when they register (comma-separated)
ADMIN_EMAILS=
